{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*.ts"],

  "exclude": ["dist", "node_modules"]
}
