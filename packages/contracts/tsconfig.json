{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*.ts",
    "../../apps/auth-service/src/auth/auth.controller.ts"
  ],

  "exclude": ["dist", "node_modules"]
}
