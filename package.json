{
  "name": "barber-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @barber/database generate",
    "db:validate": "pnpm --filter @barber/database validate",
    "db:migrate": "pnpm --filter @barber/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @barber/database migrate:deploy",
    "db:studio": "pnpm --filter @barber/database studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "2.5.6"
  }
}